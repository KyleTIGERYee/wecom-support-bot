<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kyle.wecom-support-bot</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/kyle/.local/node/bin/node</string>
        <string>/Users/kyle/Desktop/VIBECODING/wecom-support-bot/src/index.js</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/kyle/Desktop/VIBECODING/wecom-support-bot</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/kyle/.local/node/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>LANG</key>
        <string>zh_CN.UTF-8</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <!-- 优雅退出最多等 30 秒把在途问题答完，launchd 给到 40 秒再强杀 -->
    <key>ExitTimeOut</key>
    <integer>40</integer>
    <key>StandardOutPath</key>
    <string>/Users/kyle/Desktop/VIBECODING/wecom-support-bot/logs/launchd.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/kyle/Desktop/VIBECODING/wecom-support-bot/logs/launchd.stderr.log</string>
</dict>
</plist>
